rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Write access requires a Firebase Auth account. Accounts are created
    // manually in the Firebase Console (Authentication -> Users); there is
    // no self-registration, so any signed-in user is an admin.
    //
    // This replaces the previous shared-key check. That key shipped inside
    // the public JS bundle, which let anyone read, modify and delete every
    // booking and inquiry without signing in.
    function isAdmin() {
      return request.auth != null;
    }

    // Dates only — publicly readable so the guest calendar can show which
    // days are taken. Guest data lives in /bookingDetails, never here.
    match /occupancy/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Guest data belonging to a booking (same document id as /occupancy).
    // Never publicly readable.
    match /bookingDetails/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Inquiries hold guest contact data: anyone may submit one via the
    // booking form, but only admins can read them back.
    match /inquiries/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'guests', 'message',
          'arrival', 'departure', 'status', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 200 &&
        request.resource.data.arrival is string &&
        request.resource.data.departure is string &&
        request.resource.data.status == 'neu' &&
        (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 40) &&
        (!('guests' in request.resource.data) || request.resource.data.guests is number) &&
        (!('message' in request.resource.data) || request.resource.data.message.size() <= 2000);
    }

    // Settings: read-only
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
